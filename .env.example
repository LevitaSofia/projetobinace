# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env (segredos).

# Ambiente
ENV=dev
API_TOKEN=

# Binance (CCXT)
BINANCE_API_KEY=
BINANCE_SECRET=
PROXY_URL=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI
OPENAI_API_KEY=

# Trading / regras financeiras
LUCRO_MINIMO_TAXAS=0.6

# Relatório diário por e-mail (Gmail SMTP)
EMAIL_ENABLED=false
EMAIL_TO=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Horário do fechamento diário (SP) para e-mail/Telegram
DAILY_EMAIL_REPORT_HOUR=23
DAILY_EMAIL_REPORT_MINUTE=59

# Caçadora Autônoma (CoinGecko)
ENABLE_CACADOR=true
CACADOR_INTERVAL_S=3600
CACADOR_MAX_RANK=30
CACADOR_MAX_NEW=3
CACADOR_MAX_JUDGE=3

# Juiz (IA) para filtrar moedas
ENABLE_JUIZ=true
JUIZ_MODEL=gpt-4o-mini
JUIZ_CACHE_TTL_S=86400

# Organização de dados (opcional)
PROJECT_DATA_DIR=data
